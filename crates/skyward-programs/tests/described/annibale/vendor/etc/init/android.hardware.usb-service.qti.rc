on property:dev.bootcomplete=1
       chown system system /sys/class/usb_enhance/usb_enhance/current_eye_tune
       chown system system /sys/class/usb_enhance/usb_enhance/usb_enhance_state
       chown system system /sys/class/usb_enhance/usb_enhance/usb_enhance_support_mode

service vendor.usb-hal /vendor/bin/hw/android.hardware.usb-service.qti
    class hal
    user system
    group system mtp usb
