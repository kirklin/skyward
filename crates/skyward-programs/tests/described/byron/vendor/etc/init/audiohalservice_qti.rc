service vendor.audio-hal-aidl /vendor/bin/hw/audiohalservice.qti
    class hal
    user audioserver
    group audio media mediadrm drmrpc inet net_bt net_bt_admin net_bw_acct wakelock context_hub oem_2901 oem_2912
    capabilities BLOCK_SUSPEND SYS_NICE
    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    writepid /dev/cpuset/foreground/tasks /dev/stune/foreground/tasks
    socket audio_holder_socket_0 seqpacket 0666 system system
    onrestart restart audioserver

# SSR trigger for audio subsystem
on property:vendor.audio.ssr.trigger=1
    write /sys/kernel/boot_adsp/ssr 1

on boot
    chown media audio /sys/kernel/snd_card/card_state
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input0/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input1/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input2/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input3/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input4/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input5/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input6/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input7/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input8/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input9/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input10/calibration/redc_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input0/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input1/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input2/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input3/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input4/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input5/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input6/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input7/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input8/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input9/calibration/f0_stored
    chmod 777 /sys/bus/i2c/drivers/cs40l26/13-0043/input/input10/calibration/f0_stored

on post-fs-data
    # Create directory used by audio subsystem
    mkdir /data/vendor/audio 0770 audio audio
    mkdir /data/vendor/audio_dsp 0770 media media
    mkdir /data/vendor/audio/audio_feature_stats 0770 audio audio
    mkdir /data/vendor/audio/memlog 0770 audio audio

    # Create directory for audio delta files
    mkdir /data/vendor/audio/acdbdata 0770 media audio
    mkdir /data/vendor/audio/acdbdata/delta 0770 media audio

on property:sys.boot_completed=1
    chown media audio /sys/kernel/aud_dev/state