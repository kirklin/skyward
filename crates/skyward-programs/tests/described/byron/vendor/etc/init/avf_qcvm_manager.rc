on post-fs-data
    restorecon -R /mnt/vendor/vm-persist
    restorecon -R /mnt/vendor/vm-persist/trustedvm
    restorecon /mnt/vendor/vm-persist/trustedvm/persist.img
    mkdir /data/vendor/qtvm_dtbo 0777 root root

service vendor.qti.AvfQcvmManager /vendor/bin/avf_qcvm_manager
  user root
  group root system virtualmachine
  capabilities IPC_LOCK NET_BIND_SERVICE SYS_RESOURCE SYS_NICE
  stdio_to_kmsg
  class early_hal
