on boot
    mkdir /dev/socket/qcrild 0750 radio radio

service vendor.qcrild /vendor/bin/hw/qcrilNrd
    class main
    user radio
    disabled
    group radio cache inet misc audio log readproc wakelock oem_2901 oem_2912
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

service vendor.qcrild2 /vendor/bin/hw/qcrilNrd -c 2
    class main
    user radio
    disabled
    group radio cache inet misc audio log readproc wakelock oem_2901 oem_2912
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

service vendor.qcrild3 /vendor/bin/hw/qcrilNrd -c 3
    class main
    user radio
    disabled
    group radio cache inet misc audio log readproc wakelock oem_2901 oem_2912
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW

service vendor.qcrild_bootservice-sh /vendor/bin/init.qcrild.sh "boot"
    class main
    user root
    group root
    oneshot

service vendor.qcrild_service-sh /vendor/bin/init.qcrild.sh
    class main
    user root
    disabled
    group root
    oneshot

on property:vold.decrypt=trigger_restart_framework
    start vendor.qcrild_service-sh

on boot
    start vendor.qcrild

on boot && property:persist.radio.multisim.config=dsds
    start vendor.qcrild2

on boot && property:persist.radio.multisim.config=DSDS
    start vendor.qcrild2

on property:persist.radio.multisim.config=* && property:sys.boot_completed=1
    start vendor.qcrild_service-sh

on property:ro.boot.product.vendor.sku=tuna
    setprop persist.vendor.radio.dsds_to_ss 1
    setprop persist.vendor.radio.dsds_to_ss_timer 120000

on property:ro.boot.product.vendor.sku=kera
    setprop persist.vendor.radio.dsds_to_ss 1
    setprop persist.vendor.radio.dsds_to_ss_timer 120000

# MIUI ADD: Telephony_CallEnhance
on property:persist.radio.restart_rild=1
    stop vendor.qcrild
    start vendor.qcrild
on property:persist.radio.restart_rild=2
    stop vendor.qcrild
    stop vendor.qcrild2
    start vendor.qcrild
    start vendor.qcrild2
# END Telephony_CallEnhance

on early-init && property:ro.baseband=apq
    setprop ro.radio.noril yes
