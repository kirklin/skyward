service minkipcbinder-service /vendor/bin/hw/vendor.qti.hardware.minkipcbinder@1.0-service
   class hal
   user system
   group system
   interface aidl vendor.qti.hardware.minkipcbinder.IMinkServer/default
   disabled
   oneshot
