service wfdvndservice /vendor/bin/wfdvndservice
  class main
  user system
  group inet
  disabled
  oneshot

on property:vendor.qti.wfd.wfdhdcpvndservice=enable
    start wfdvndservice

on property:vendor.qti.wfd.wfdhdcpvndservice=disable
    stop wfdvndservice
