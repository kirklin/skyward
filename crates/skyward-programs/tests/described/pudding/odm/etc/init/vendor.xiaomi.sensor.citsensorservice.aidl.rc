service citsensorservice  /odm/bin/hw/vendor.xiaomi.sensor.citsensorservice.aidl
    class late_start
    user system
    group system input
    capabilities SYS_NICE

on post-fs-data
    #aon dum dir
    mkdir /data/vendor/aon 0764 system system
