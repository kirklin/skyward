# MIUI ADD: Display_GamePostProcessing
service vendor.gppservice /system_ext/bin/gppservice
    class main
    user system
    group system
    # start only when requested (comment below to start service at boot)
    disabled

on property:ro.vendor.display.gppservice.support=true
    start vendor.gppservice

# END Display_GamePostProcessing

on property:vendor.gpp.frc.enable=22
    start vendor.gppservice

on property:vendor.gpp.frc.enable=0x22
    start vendor.gppservice

