diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index d690518..647d0d7 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -14,6 +14,10 @@ on:
         description: The codename of the one device to build for; every device when empty
         required: false
         default: ""
+      stock_recovery_url:
+        description: Optional HTTPS URL of a local-only device's stock recovery (SHA-256 checked)
+        required: false
+        default: ""

 permissions:
   contents: read
@@ -51,12 +55,12 @@ jobs:
         run: cargo build --locked --release -p skyward-pack
       - name: Gather them
         run: |
-          mkdir tools
-          cp target/aarch64-linux-android/release/skyward target/release/skyward-pack tools/
+          mkdir tools-bin
+          cp target/aarch64-linux-android/release/skyward target/release/skyward-pack tools-bin/
       - uses: actions/upload-artifact@v7
         with:
           name: tools
